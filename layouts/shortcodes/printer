<span class="printer">
  <a href="javascript:onPrinter()" title="Print this page">🖨</a>
  <script>
    let savedDetails = null;

    function onBeforePrint() {
      // Preserve the reader's choices, even if beforeprint fires again.
      if (savedDetails === null) {
        savedDetails = Array.from(
          document.querySelectorAll('details'),
          (element) => [element, element.open]
        );
      }

      savedDetails.forEach(([element]) => {
        element.open = true;
      });

      var city = document.getElementById('caption_city');
      if (city) {
        city.innerText = 'Zürich, Switzerland';
      }
      var tel = document.getElementById('caption_phone');
      if (tel) {
        var num = "+" + "4179" + "4206" + "897";
        tel.parentElement.href = "tel:" + num;
        tel.innerText = num;
      }
    }

    function onAfterPrint() {
      if (savedDetails === null) return;

      savedDetails.forEach(([element, wasOpen]) => {
        element.open = wasOpen;
      });
      savedDetails = null;
    }

    function onPrinter() {
      window.print();
    }

    window.addEventListener('beforeprint', onBeforePrint);
    window.addEventListener('afterprint', onAfterPrint);
  </script>
</span>
